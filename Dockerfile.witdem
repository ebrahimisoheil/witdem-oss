FROM node:25-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS dashboard-build

WORKDIR /build/web
COPY web/package.json web/package-lock.json web/.npmrc ./
RUN npm install --global npm@11.4.1 && npm ci
COPY web ./
RUN npm run build

FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

WORKDIR /app

ARG WITDEM_ANALYTICS_REQUIREMENT=.

COPY pyproject.toml ./
COPY README.md ./README.md
COPY src ./src
COPY constraints/production.txt ./constraints/production.txt
COPY --from=dashboard-build /build/src/witdem/dashboard/static ./src/witdem/dashboard/static

RUN python -m pip install --no-cache-dir pip==26.2.1 \
    && python -m pip install --no-cache-dir --constraint constraints/production.txt "${WITDEM_ANALYTICS_REQUIREMENT}"

EXPOSE 4318

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD python -c "import urllib.request as u; u.urlopen('http://localhost:4318/health', timeout=2)" || exit 1

CMD ["witdem", "serve", "--host", "0.0.0.0", "--port", "4318"]
