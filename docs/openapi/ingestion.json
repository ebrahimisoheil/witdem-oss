    "/readiness": {
      "get": {
        "description": "Minimal reachability check for the ingest + storage + read path.\n\nThis does not validate every ingest code path; it confirms\nthe two things a load balancer/orchestrator actually needs to know before\nrouting traffic here: (1) the live DuckDB file this service upserts\ncanonical analytics into is reachable and queryable (``ingest.live_db``,\nthe same file the dashboard also reads), and (2) the raw span storage\ndirectory (``ingest.raw_store``) this service persists to before every\nOTLP export is decoded is reachable. A failure in either returns HTTP 503\nwith the specific error, rather than a bare \"ok\"/500 that hides which\ndependency is down.\n\nUses ``live_db.ping()`` rather than ``live_db.get_connection()`` on\npurpose: ``ping()`` opens its own connection and closes it immediately,\nso a readiness probe, polled repeatedly by a container healthcheck such as\ndocker-compose.yml's 10-second check, never itself becomes a standing\nopen connection that would defeat ``ingest.live_db``'s close-after-every-\nwrite behavior (see that module's docstring) and permanently block the\ndashboard's read-only access.",
        "operationId": "readiness_readiness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Readiness Readiness Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    },
    "/sdk/v1/records": {
      "post": {
        "description": "Validate and durably commit one SDK wire record.\n\nReturns HTTP 400 with a clear message for any invalid input (bad JSON,\nwrong shape, unknown version/kind, missing required field, or -- when a\ndomain config is configured -- an out-of-vocabulary name/value).",
        "operationId": "create_record_sdk_v1_records_post",
        "responses": {
