# Provider credentials. Keep real values in .env or the shell environment.
OPENAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# Witdem reference endpoint. Content capture is always disabled by the matrix.
WITDEM_ENDPOINT=http://localhost:4318
WITDEM_DASHBOARD_URL=http://localhost:8501

# Historical workflow configuration (non-authoritative archived experiments)
PF_SCENARIO=company-research
PF_WORKFLOW_VERSION=0.1.0
PF_RESEARCH_PROVIDER=fixture
PF_RESEARCH_MODEL_PROVIDER=openai
PF_RESEARCH_MODEL=gpt-5.4-mini
PF_EXTRACTION_MODEL_PROVIDER=openai
PF_EXTRACTION_MODEL=gpt-5.4-mini
PF_VERIFICATION_MODEL_PROVIDER=openai
PF_VERIFICATION_MODEL=gpt-5.4-mini
PF_EMBEDDING_MODEL=voyage-4-lite
PF_MAX_RESEARCH_PASSES=2
PF_MAX_PROFILE_REPAIRS=1
PF_MAX_MODEL_CALLS=12
PF_ACCEPTANCE_MIN_QUALITY_SCORE=0.75
PF_EXPERIMENT_MAX_ESTIMATED_COST_USD=20

# Storage and tracing
PF_DATA_DIR=data
PF_CONTENT_TRACING_ENABLED=false
PF_OTLP_ENDPOINT=
